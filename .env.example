DB_PASSWORD=definir-clave-local
DB_USER=postgres
DB_NAME=users_db
DB_PORT=5435
SERVER_PORT=8083
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:3001
# Issuer v2 de tu tenant; audience de TU API, nunca Microsoft Graph.
ENTRA_ISSUER=
ENTRA_AUDIENCE=
ENTRA_SCOPE=access_as_user
# https://cognito-idp.<region>.amazonaws.com/<user-pool-id>
COGNITO_ISSUER=
COGNITO_CLIENT_ID=
# RabbitMQ compartido. No subir la contraseña real al repositorio.
RABBITMQ_ENABLED=true
RABBITMQ_HOST=blackout-rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=blackout
RABBITMQ_PASSWORD=definir-clave-rabbitmq
